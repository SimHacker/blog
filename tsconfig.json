{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
			"svelte", 
			"./src/types/import-meta.d.ts"
		]
  },
  "include": [
		"src/**/*.ts", 
		"src/**/*.svelte"
	],
  "exclude": [
		"node_modules", 
		"dist"
	]
}